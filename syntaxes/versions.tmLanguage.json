{
  "name": "Confetti Tool Versions",
  "scopeName": "source.confetti.versions",
  "patterns": [
    { "name": "comment.line.number-sign.versions", "match": "#.*$" },
    {
      "match": "^\\s*([A-Za-z][A-Za-z0-9_-]*)(?=\\s+)",
      "captures": { "1": { "name": "entity.name.tool.versions" } }
    },
    {
      "name": "constant.numeric.version.versions",
      "match": "(?<![A-Za-z0-9])v?\\d+(?:\\.\\d+){1,3}(?:[-+][A-Za-z0-9.-]+)?"
    },
    {
      "name": "constant.language.version-alias.versions",
      "match": "(?i)\\b(?:lts/\\S+|latest|system|ref:\\S+|path:\\S+)\\b"
    }
  ]
}
