{
  "name": "Confetti YAML",
  "scopeName": "source.confetti.yaml",
  "patterns": [
    {
      "include": "#block-scalars"
    },
    {
      "name": "comment.line.number-sign.yaml",
      "match": "#.*$"
    },
    {
      "name": "keyword.control.directive.yaml",
      "match": "^%[A-Z]+\\b.*$"
    },
    {
      "name": "keyword.control.document.yaml",
      "match": "^\\s*(?:---|\\.\\.\\.)\\s*$"
    },
    {
      "match": "^\\s*(?:(-)\\s+)+((?:[^#\\[\\]{},&*!|>'\"%@`:\\s]|:(?!\\s))+|\"(?:\\\\.|[^\"])*\"|'(?:''|[^'])*')(\\s*:)(?=\\s|$)",
      "captures": {
        "1": {
          "name": "punctuation.definition.sequence.item.yaml"
        },
        "2": {
          "name": "entity.name.tag.yaml"
        },
        "3": {
          "name": "punctuation.separator.key-value.yaml"
        }
      }
    },
    {
      "match": "^([ ]*)(-)(?=\\s|$)",
      "captures": {
        "2": {
          "name": "punctuation.definition.sequence.item.yaml"
        }
      }
    },
    {
      "match": "^\\s*((?:[^#\\[\\]{},&*!|>'\"%@`:\\s]|:(?!\\s))+|\"(?:\\\\.|[^\"])*\"|'(?:''|[^'])*')(\\s*:)(?=\\s|$)",
      "captures": {
        "1": {
          "name": "entity.name.tag.yaml"
        },
        "2": {
          "name": "punctuation.separator.key-value.yaml"
        }
      }
    },
    {
      "name": "string.quoted.double.yaml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.yaml",
          "match": "\\\\(?:.|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        }
      ]
    },
    {
      "name": "string.quoted.single.yaml",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.yaml",
          "match": "''"
        }
      ]
    },
    {
      "name": "keyword.control.block-scalar.yaml",
      "match": "[|>](?:[+-][1-9]?|[1-9][+-]?)(?=\\s*(?:#.*)?$)|[|>](?=\\s*(?:#.*)?$)"
    },
    {
      "name": "entity.name.type.anchor.yaml",
      "match": "&[A-Za-z0-9_-]+"
    },
    {
      "name": "variable.other.alias.yaml",
      "match": "\\*[A-Za-z0-9_-]+"
    },
    {
      "name": "storage.type.tag-handle.yaml",
      "match": "!!?[A-Za-z0-9_:/.-]+"
    },
    {
      "name": "constant.language.null.yaml",
      "match": "(?i)(?<![A-Za-z0-9_-])(?:null|~)(?![A-Za-z0-9_-])"
    },
    {
      "name": "constant.language.boolean.yaml",
      "match": "(?i)\\b(?:true|false)\\b"
    },
    {
      "name": "constant.numeric.datetime.yaml",
      "match": "\\b\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[-+]\\d{2}:?\\d{2})?)?\\b"
    },
    {
      "name": "constant.numeric.yaml",
      "match": "(?<![A-Za-z0-9_.-])[-+]?(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+|(?:\\d[\\d_]*)(?:\\.[\\d_]+)?(?:[eE][-+]?\\d+)?)\\b"
    },
    {
      "name": "punctuation.definition.flow.yaml",
      "match": "[\\[\\]{},]"
    }
  ],
  "repository": {
    "block-scalars": {
      "patterns": [
        {
          "name": "meta.scalar.block.yaml",
          "begin": "^([ ]*)((?:[^#\\[\\]{},&*!|>'\"%@`:\\s]|:(?!\\s))+|\"(?:\\\\.|[^\"])*\"|'(?:''|[^'])*')([ ]*:)[ ]*([|>][+-]?)[ \\t]*(#.*)?$",
          "beginCaptures": {
            "2": {
              "name": "entity.name.tag.yaml"
            },
            "3": {
              "name": "punctuation.separator.key-value.yaml"
            },
            "4": {
              "name": "keyword.control.block-scalar.yaml"
            },
            "5": {
              "name": "comment.line.number-sign.yaml"
            }
          },
          "while": "^(?:\\1 +|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml"
        },
        {
          "name": "meta.scalar.block.yaml",
          "begin": "^([ ]*)((?:[^#\\[\\]{},&*!|>'\"%@`:\\s]|:(?!\\s))+|\"(?:\\\\.|[^\"])*\"|'(?:''|[^'])*')([ ]*:)[ ]*([|>]([1-9])[+-]?)[ \\t]*(#.*)?$",
          "beginCaptures": {
            "2": {
              "name": "entity.name.tag.yaml"
            },
            "3": {
              "name": "punctuation.separator.key-value.yaml"
            },
            "4": {
              "name": "keyword.control.block-scalar.yaml"
            },
            "6": {
              "name": "comment.line.number-sign.yaml"
            }
          },
          "while": "^(?:\\1 {\\5}|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml"
        },
        {
          "name": "meta.scalar.block.yaml",
          "begin": "^([ ]*)((?:[^#\\[\\]{},&*!|>'\"%@`:\\s]|:(?!\\s))+|\"(?:\\\\.|[^\"])*\"|'(?:''|[^'])*')([ ]*:)[ ]*([|>][+-]([1-9]))[ \\t]*(#.*)?$",
          "beginCaptures": {
            "2": {
              "name": "entity.name.tag.yaml"
            },
            "3": {
              "name": "punctuation.separator.key-value.yaml"
            },
            "4": {
              "name": "keyword.control.block-scalar.yaml"
            },
            "6": {
              "name": "comment.line.number-sign.yaml"
            }
          },
          "while": "^(?:\\1 {\\5}|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml"
        },
        {
          "name": "meta.scalar.block.yaml",
          "begin": "^([ ]*)(-)([ ]+)((?:[^#\\[\\]{},&*!|>'\"%@`:\\s]|:(?!\\s))+|\"(?:\\\\.|[^\"])*\"|'(?:''|[^'])*')([ ]*:)[ ]*([|>][+-]?)[ \\t]*(#.*)?$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.sequence.item.yaml"
            },
            "4": {
              "name": "entity.name.tag.yaml"
            },
            "5": {
              "name": "punctuation.separator.key-value.yaml"
            },
            "6": {
              "name": "keyword.control.block-scalar.yaml"
            },
            "7": {
              "name": "comment.line.number-sign.yaml"
            }
          },
          "while": "^(?:\\1\\3  +|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml"
        },
        {
          "name": "meta.scalar.block.yaml",
          "begin": "^([ ]*)(-)([ ]+)((?:[^#\\[\\]{},&*!|>'\"%@`:\\s]|:(?!\\s))+|\"(?:\\\\.|[^\"])*\"|'(?:''|[^'])*')([ ]*:)[ ]*([|>]([1-9])[+-]?)[ \\t]*(#.*)?$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.sequence.item.yaml"
            },
            "4": {
              "name": "entity.name.tag.yaml"
            },
            "5": {
              "name": "punctuation.separator.key-value.yaml"
            },
            "6": {
              "name": "keyword.control.block-scalar.yaml"
            },
            "8": {
              "name": "comment.line.number-sign.yaml"
            }
          },
          "while": "^(?:\\1\\3  {\\7}|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml"
        },
        {
          "name": "meta.scalar.block.yaml",
          "begin": "^([ ]*)(-)([ ]+)((?:[^#\\[\\]{},&*!|>'\"%@`:\\s]|:(?!\\s))+|\"(?:\\\\.|[^\"])*\"|'(?:''|[^'])*')([ ]*:)[ ]*([|>][+-]([1-9]))[ \\t]*(#.*)?$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.sequence.item.yaml"
            },
            "4": {
              "name": "entity.name.tag.yaml"
            },
            "5": {
              "name": "punctuation.separator.key-value.yaml"
            },
            "6": {
              "name": "keyword.control.block-scalar.yaml"
            },
            "8": {
              "name": "comment.line.number-sign.yaml"
            }
          },
          "while": "^(?:\\1\\3  {\\7}|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml"
        },
        {
          "name": "meta.scalar.block.yaml",
          "begin": "^([ ]*)(-)[ ]+([|>][+-]?)[ \\t]*(#.*)?$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.sequence.item.yaml"
            },
            "3": {
              "name": "keyword.control.block-scalar.yaml"
            },
            "4": {
              "name": "comment.line.number-sign.yaml"
            }
          },
          "while": "^(?:\\1 +|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml"
        },
        {
          "name": "meta.scalar.block.yaml",
          "begin": "^([ ]*)(-)[ ]+([|>]([1-9])[+-]?)[ \\t]*(#.*)?$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.sequence.item.yaml"
            },
            "3": {
              "name": "keyword.control.block-scalar.yaml"
            },
            "5": {
              "name": "comment.line.number-sign.yaml"
            }
          },
          "while": "^(?:\\1 {\\4}|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml"
        },
        {
          "name": "meta.scalar.block.yaml",
          "begin": "^([ ]*)(-)[ ]+([|>][+-]([1-9]))[ \\t]*(#.*)?$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.sequence.item.yaml"
            },
            "3": {
              "name": "keyword.control.block-scalar.yaml"
            },
            "5": {
              "name": "comment.line.number-sign.yaml"
            }
          },
          "while": "^(?:\\1 {\\4}|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml"
        }
      ]
    }
  }
}
