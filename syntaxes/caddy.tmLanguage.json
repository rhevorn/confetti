{
  "name": "Confetti Caddyfile",
  "scopeName": "source.confetti.caddy",
  "patterns": [
    {
      "name": "string.quoted.double.caddy",
      "begin": "(?<!\\S)\"",
      "end": "\"",
      "patterns": [
        { "name": "variable.other.caddy", "match": "\\{[^{}\\r\\n]+\\}" },
        {
          "name": "constant.character.escape.caddy",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.raw.caddy",
      "begin": "(?<!\\S)`",
      "end": "`",
      "patterns": [
        { "name": "variable.other.caddy", "match": "\\{[^{}\\r\\n]+\\}" }
      ]
    },
    {
      "name": "string.unquoted.heredoc.caddy",
      "begin": "(?<!\\S)<<([A-Za-z0-9_-]+)\\s*$",
      "end": "^\\s*\\1(?=\\s|$)"
    },
    {
      "name": "meta.section.caddy",
      "match": "^\\s*([^#\"`\\r\\n]*?)\\s+(\\{)\\s*(#.*)?$",
      "captures": {
        "1": {
          "name": "entity.name.section.caddy"
        },
        "2": {
          "name": "punctuation.definition.section.begin.caddy"
        },
        "3": {
          "name": "comment.line.number-sign.caddy"
        }
      }
    },
    {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_-]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.other.directive.caddy"
        }
      }
    },
    {
      "name": "variable.other.matcher.caddy",
      "match": "@[A-Za-z0-9_-]+"
    },
    {
      "name": "variable.other.caddy",
      "match": "\\{[^{}\\r\\n]*\\}"
    },
    {
      "name": "comment.line.number-sign.caddy",
      "match": "(?<!\\S)#.*$"
    },
    {
      "name": "constant.numeric.caddy",
      "match": "(?<![A-Za-z0-9_.-])\\d+(?:\\.\\d+)?\\b"
    }
  ]
}
