{
  "name": "Confetti MySQL Config",
  "scopeName": "source.confetti.mysql",
  "patterns": [
    { "name": "comment.line.semicolon.mysql", "match": "^\\s*[;#].*$" },
    {
      "name": "meta.section.mysql",
      "match": "^\\s*(\\[)([^\\]\\r\\n]+)(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.section.begin.mysql" },
        "2": { "name": "entity.name.section.mysql" },
        "3": { "name": "punctuation.definition.section.end.mysql" }
      }
    },
    {
      "match": "^\\s*([^;#=:\\s][^=:\\r\\n]*?)(\\s*[=:])",
      "captures": {
        "1": { "name": "support.type.property-name.mysql" },
        "2": { "name": "keyword.operator.assignment.mysql" }
      }
    },
    {
      "name": "string.quoted.double.mysql",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.mysql", "match": "\\\\." }
      ]
    },
    { "name": "string.quoted.single.mysql", "begin": "'", "end": "'" },
    {
      "name": "constant.language.boolean.mysql",
      "match": "(?i)\\b(?:true|false|yes|no|on|off|null|none)\\b"
    },
    {
      "name": "constant.numeric.mysql",
      "match": "(?<![A-Za-z0-9_.-])[-+]?\\d+(?:\\.\\d+)?\\b"
    },
    {
      "name": "string.unquoted.path.mysql",
      "match": "(?<![\\w.])(?:/[\\w.-]+)+/?"
    }
  ]
}
