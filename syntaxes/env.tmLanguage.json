{
  "name": "Confetti Environment Variables",
  "scopeName": "source.confetti.env",
  "patterns": [
    { "name": "comment.line.number-sign.env", "match": "^\\s*#.*$" },
    {
      "name": "meta.assignment.env",
      "begin": "^\\s*(?:(export)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(\\s*=\\s*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.env" },
        "2": { "name": "support.type.property-name.env" },
        "3": { "name": "keyword.operator.assignment.env" }
      },
      "end": "$",
      "contentName": "string.unquoted.env",
      "patterns": [
        { "include": "#strings" },
        { "include": "#variables" },
        {
          "name": "comment.line.number-sign.env",
          "match": "(?<=\\s)#.*$"
        },
        {
          "name": "constant.language.boolean.env",
          "match": "(?i)\\b(?:true|false|yes|no|on|off)\\b"
        },
        {
          "name": "constant.numeric.env",
          "match": "(?<![A-Za-z0-9_.-])[-+]?\\d+(?:\\.\\d+)?\\b"
        }
      ]
    }
  ],
  "repository": {
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.env",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.env", "match": "\\\\." },
            { "include": "#variables" }
          ]
        },
        { "name": "string.quoted.single.env", "begin": "'", "end": "'" }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.braced.env",
          "match": "\\$\\{[^}\\r\\n]+\\}"
        },
        {
          "name": "variable.other.env",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    }
  }
}
