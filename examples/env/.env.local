# Keys and values must receive visibly different scopes.
export APP_ENV=development
APP_NAME="Confetti Demo"
API_URL=https://api.example.test/v1?debug=true#fragment
API_TOKEN=${CONFETTI_TEST_TOKEN}
PORT=8080
    FEATURE_ENABLED=true
RETRY_COUNT=3
EMPTY_VALUE=
SPACES="keep  two  spaces"
HASH_INSIDE_QUOTES="this # is not a comment"
SINGLE_QUOTED='${NOT_EXPANDED}'
DEFAULT_PORT=${PORT:-3000}
ESCAPED_NEWLINE="first\nsecond"
INLINE_COMMENT=value # this is a comment
# The duplicate APP_NAME below intentionally triggers a duplicate-key warning.
APP_NAME="overridden by a duplicate"
