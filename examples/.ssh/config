# Global directives remain at the root.
AddKeysToAgent yes
ServerAliveInterval 30

# Host directives should be indented consistently.
Host work work-alias
  HostName example.com
  User deploy
  Port 2222
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump bastion
  LocalForward 5432 db.internal:5432
  RemoteCommand cd /srv/app && exec $SHELL

Host *.internal !legacy.internal
  User ops
  CanonicalizeHostname yes
  ControlPath ~/.ssh/control-%C

Match host *.example.com user deploy
  ForwardAgent no
  SendEnv LANG LC_*
