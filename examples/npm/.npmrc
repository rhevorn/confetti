# Registry and authentication
registry=https://registry.npmjs.org/
@confetti:registry=https://registry.example.test/
//registry.example.test/:_authToken=${NPM_TOKEN}

# Boolean and numeric options
save-exact=true
strict-ssl=true
audit=false
fetch-retries=3
fetch-timeout=60000

# Paths and environment interpolation
cache=${HOME}/.npm-cache
prefix=~/.local
userconfig=${HOME}/.config/npm/npmrc
