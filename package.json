          "tmux.conf"
        ],
        "filenamePatterns": [
          "**/.tmux.conf",
          "**/.config/tmux/tmux.conf"
        ],
        "configuration": "./language-configurations/line-based.json"
      },
      {
        "id": "confetti-screen",
        "aliases": [
          "screen Config",
          "screenrc"
        ],
        "filenames": [
          ".screenrc",
          "screenrc"
        ],
        "configuration": "./language-configurations/line-based.json"
