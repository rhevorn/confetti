{
  "name": "confetti",
  "displayName": "Confetti",
  "description": "Detect, highlight, and format .env, .ini, .toml, .yml, .conf, nginx, Apache, MySQL, tmux, gitignore, SSH, and 15+ other config files in one local extension, with folding, outlines, snippets, and duplicate-key diagnostics.",
  "version": "1.4.1",
  "private": true,
  "publisher": "rhevorn",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhevorn/confetti.git"
  },
  "homepage": "https://github.com/rhevorn/confetti#readme",
  "bugs": {
    "url": "https://github.com/rhevorn/confetti/issues"
  },
  "galleryBanner": {
    "color": "#161B4F",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "config files",
    "config",
    "formatter",
    "format document",
    "syntax highlighting",
    "language detection",
    "nginx",
    "apache",
    "htaccess",
    "dotenv",
    "env",
    "toml",
    "yaml",
    "yml",
    "conf",
    "ini",
    "my.cnf",
    "mysql",
    "pip.conf",
    "setup.cfg",
    "properties",
    "ssh",
    "gitignore",
    "gitattributes",
    "git config",
    "npmrc",
    "yarnrc",
    "browserslist",
    "cursorignore",
    "vscodeignore",
    "nvmrc",
    "tool versions",
    "hosts",
    "fstab",
    "crontab",
    "tmux",
    "screenrc",
    "inputrc",
    "snippets",
    "systemd",
    "systemd unit",
    "tox.ini",
    "flake8",
    "caddy",
    "caddyfile"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "files": [
    "dist",
    "syntaxes",
    "snippets",
    "language-configurations",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "images/icon.png",
    "LICENSE"
  ],
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:vscode": "npm run build && node scripts/test-vscode.mjs",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "contributes": {
    "commands": [
      {
        "command": "confetti.detectConfigType",
        "title": "Detect Config Type",
        "category": "Confetti"
      },
      {
        "command": "confetti.formatConfig",
        "title": "Format Config",
        "category": "Confetti"
      },
      {
        "command": "confetti.previewFormatting",
        "title": "Preview Formatting",
        "category": "Confetti"
      },
      {
        "command": "confetti.showDetectionInfo",
        "title": "Show Detection Info",
        "category": "Confetti"
      },
      {
        "command": "confetti.showOutput",
        "title": "Show Formatter Output",
        "category": "Confetti"
      }
    ],
    "configuration": {
      "title": "Confetti",
      "properties": {
        "confetti.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect supported configuration files when they are opened, activated, or saved."
        },
        "confetti.autoDetectFormats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Restrict automatic language detection to these format ids, such as \"nginx\" or \"ssh\". An empty list enables detection for every supported format."
        },
        "confetti.associations": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "nginx",
              "apache",
              "ssh",
              "systemd",
              "env",
              "ini",
              "mysql",
              "pip",
              "pyini",
              "setupcfg",
              "properties",
              "toml",
              "gitconfig",
              "npmrc",
              "yarnrc",
              "yaml",
              "ignore",
              "gitattributes",
              "browserslist",
              "caddy",
              "versions",
              "hosts",
              "fstab",
              "crontab",
              "tmux",
              "screen",
              "inputrc"
            ]
          },
          "description": "Associate project-specific filename patterns with a supported Confetti format id. More specific matching patterns take precedence."
        },
        "confetti.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Highlight duplicate keys and table headers in supported configuration files. Diagnostics only run when files are opened, activated, or saved, never while typing."
        },
        "confetti.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable document formatting for supported configuration files."
        },
        "confetti.format.formats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Restrict formatting to these format ids, such as \"nginx\" or \"ssh\". An empty list formats every supported format."
        }
      }
    },
    "snippets": [
      {
        "language": "confetti-nginx",
        "path": "./snippets/nginx.json"
      }
    ],
    "languages": [
      {
        "id": "confetti-nginx",
        "aliases": [
          "Nginx",
          "nginx"
        ],
        "filenames": [
          "nginx.conf"
        ],
        "configuration": "./language-configurations/nginx.json"
      },
      {
        "id": "confetti-apache",
        "aliases": [
          "Apache Config",
          "apache"
        ],
        "filenames": [
          ".htaccess",
          "httpd.conf",
          "apache2.conf"
        ],
        "filenamePatterns": [
          "**/apache2/*.conf",
          "**/httpd/*.conf",
          "**/apache2/sites-available/*",
          "**/apache2/sites-enabled/*"
        ],
        "configuration": "./language-configurations/line-based.json"
      },
      {
        "id": "confetti-ssh",
        "aliases": [
          "SSH Config",
          "ssh-config"
        ],
        "filenames": [
          "ssh_config",
          "sshd_config"
        ],
        "filenamePatterns": [
          "**/.ssh/config"
        ],
        "configuration": "./language-configurations/ssh.json"
      },
      {
        "id": "confetti-env",
        "aliases": [
          "Environment Variables",
          "dotenv"
        ],
        "filenames": [
          ".env"
        ],
        "extensions": [
          ".env"
        ],
        "filenamePatterns": [
          ".env.*",
          "*.env"
        ],
        "configuration": "./language-configurations/key-value.json"
      },
      {
        "id": "confetti-ini",
        "aliases": [
          "INI",
          "EditorConfig"
        ],
        "configuration": "./language-configurations/ini.json"
      },
      {
        "id": "confetti-mysql",
        "aliases": [
          "MySQL Config",
          "my.cnf"
        ],
        "filenames": [
          "my.cnf",
          ".my.cnf"
        ],
        "filenamePatterns": [
          "**/mysql/*.cnf",
          "**/mariadb/*.cnf"
        ],
        "configuration": "./language-configurations/ini.json"
      },
      {
        "id": "confetti-pip",
        "aliases": [
          "pip Config",
          "pip.conf"
        ],
        "filenames": [
          "pip.conf"
        ],
        "filenamePatterns": [
          "**/.pip/pip.conf",
          "**/.config/pip/pip.conf"
        ],
        "configuration": "./language-configurations/ini.json"
      },
      {
        "id": "confetti-setupcfg",
        "aliases": [
          "setup.cfg",
          "setup config"
        ],
        "filenames": [
          "setup.cfg"
        ],
        "configuration": "./language-configurations/ini.json"
      },
      {
        "id": "confetti-properties",
        "aliases": [
          "Java Properties",
          "properties"
        ],
        "configuration": "./language-configurations/properties.json"
      },
      {
        "id": "confetti-toml",
        "aliases": [
          "TOML",
          "toml"
        ],
        "extensions": [
          ".toml"
        ],
        "configuration": "./language-configurations/toml.json"
      },
      {
        "id": "confetti-gitconfig",
        "aliases": [
          "Git Config",
          "gitconfig"
        ],
        "filenames": [
          ".gitconfig",
          ".gitmodules"
        ],
        "configuration": "./language-configurations/ini.json"
      },
      {
        "id": "confetti-npmrc",
        "aliases": [
          "npm Config",
          "npmrc"
        ],
        "filenames": [
          ".npmrc"
        ],
        "configuration": "./language-configurations/key-value.json"
