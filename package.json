{
  "name": "confetti",
  "displayName": "Confetti",
  "description": "Detect, highlight, and format nginx, dotenv, gitignore, yarnrc, hosts, fstab, crontab, TOML, YAML, SSH, npmrc, and 16+ config files in one local extension.",
  "version": "1.2.0",
  "private": true,
  "publisher": "rhevorn",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhevorn/confetti.git"
  },
  "homepage": "https://github.com/rhevorn/confetti#readme",
  "bugs": {
    "url": "https://github.com/rhevorn/confetti/issues"
  },
  "galleryBanner": {
    "color": "#161B4F",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "configuration",
    "config",
    "config files",
    "formatter",
    "format document",
    "syntax highlighting",
    "language detection",
    "nginx",
    "dotenv",
    "env",
    "toml",
    "yaml",
    "ini",
    "editorconfig",
    "properties",
    "ssh",
    "gitignore",
    "gitattributes",
    "git config",
    "npmrc",
    "yarnrc",
    "browserslist",
    "cursorignore",
    "vscodeignore",
    "vercelignore",
    "nvmrc",
    "tool versions",
    "hosts",
    "fstab",
    "crontab",
    "system config"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "files": [
    "dist",
    "syntaxes",
    "language-configurations",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "images/icon.png",
    "LICENSE"
  ],
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "contributes": {
    "commands": [
      {
        "command": "confetti.detectConfigType",
        "title": "Detect Config Type",
        "category": "Confetti"
      },
      {
        "command": "confetti.formatConfig",
        "title": "Format Config",
        "category": "Confetti"
      },
      {
        "command": "confetti.showDetectionInfo",
        "title": "Show Detection Info",
        "category": "Confetti"
      },
      {
        "command": "confetti.showOutput",
        "title": "Show Formatter Output",
        "category": "Confetti"
      }
    ],
    "configuration": {
      "title": "Confetti",
      "properties": {
        "confetti.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect supported configuration files when they are opened, activated, or saved."
        },
        "confetti.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable document formatting for supported configuration files."
        }
      }
    },
    "languages": [
      {
        "id": "confetti-nginx",
        "aliases": [
          "Nginx",
          "nginx"
        ],
        "filenames": [
          "nginx.conf"
        ],
        "configuration": "./language-configurations/nginx.json"
      },
      {
        "id": "confetti-ssh",
        "aliases": [
          "SSH Config",
          "ssh-config"
        ],
        "filenames": [
          "ssh_config",
          "sshd_config"
        ],
        "configuration": "./language-configurations/ssh.json"
      },
      {
        "id": "confetti-env",
        "aliases": [
          "Environment Variables",
          "dotenv"
        ],
        "filenames": [
          ".env"
        ],
        "extensions": [
          ".env"
        ],
        "filenamePatterns": [
          ".env.*",
          "*.env"
        ],
        "configuration": "./language-configurations/key-value.json"
      },
      {
        "id": "confetti-ini",
        "aliases": [
          "INI",
          "EditorConfig"
        ],
        "configuration": "./language-configurations/ini.json"
      },
      {
        "id": "confetti-properties",
        "aliases": [
          "Java Properties",
          "properties"
        ],
        "configuration": "./language-configurations/properties.json"
      },
      {
        "id": "confetti-toml",
        "aliases": [
          "TOML",
          "toml"
        ],
        "extensions": [
          ".toml"
        ],
        "configuration": "./language-configurations/toml.json"
      },
      {
        "id": "confetti-gitconfig",
        "aliases": [
          "Git Config",
          "gitconfig"
        ],
        "filenames": [
          ".gitconfig",
          ".gitmodules"
        ],
        "configuration": "./language-configurations/ini.json"
      },
      {
        "id": "confetti-npmrc",
        "aliases": [
          "npm Config",
          "npmrc"
        ],
        "filenames": [
          ".npmrc"
        ],
        "configuration": "./language-configurations/key-value.json"
      },
      {
        "id": "confetti-yaml",
        "aliases": [
          "YAML",
          "yaml"
        ],
        "configuration": "./language-configurations/yaml.json"
      },
      {
        "id": "confetti-ignore",
        "aliases": [
          "Ignore File",
          "ignore"
        ],
        "filenames": [
          ".gitignore",
          ".dockerignore",
          ".npmignore",
          ".prettierignore",
          ".eslintignore",
          ".stylelintignore",
          ".helmignore",
          ".ignore",
          ".cursorignore",
          ".cursorindexingignore",
          ".vscodeignore",
          ".vercelignore",
          ".netlifyignore",
          ".gcloudignore",
          ".terraformignore"
        ],
        "filenamePatterns": [
          ".*ignore",
          "*.gitignore",
          "**/.git/info/exclude"
        ],
        "configuration": "./language-configurations/line-based.json"
      },
      {
        "id": "confetti-yarnrc",
        "aliases": [
          "Yarn Config",
          "yarnrc"
        ],
        "filenames": [
          ".yarnrc"
        ],
        "configuration": "./language-configurations/key-value.json"
      },
      {
        "id": "confetti-gitattributes",
        "aliases": [
          "Git Attributes",
          "gitattributes"
        ],
        "filenames": [
          ".gitattributes"
        ],
        "filenamePatterns": [
          "**/.git/info/attributes"
        ],
        "configuration": "./language-configurations/line-based.json"
      },
      {
        "id": "confetti-browserslist",
        "aliases": [
          "Browserslist",
          "browserslist"
        ],
        "filenames": [
          ".browserslistrc",
          "browserslist"
        ],
        "configuration": "./language-configurations/line-based.json"
      },
      {
        "id": "confetti-versions",
        "aliases": [
          "Tool Versions",
          "tool-versions"
        ],
        "filenames": [
          ".nvmrc",
          ".node-version",
          ".python-version",
          ".ruby-version",
          ".tool-versions"
        ],
        "configuration": "./language-configurations/line-based.json"
      },
      {
        "id": "confetti-hosts",
        "aliases": [
          "Hosts",
          "hosts"
        ],
        "filenames": [
          "hosts"
        ],
        "configuration": "./language-configurations/line-based.json"
      },
      {
        "id": "confetti-fstab",
        "aliases": [
          "Filesystem Table",
          "fstab"
        ],
        "filenames": [
          "fstab"
        ],
        "configuration": "./language-configurations/line-based.json"
      },
      {
        "id": "confetti-crontab",
        "aliases": [
          "Crontab",
          "crontab"
        ],
        "filenames": [
          "crontab"
        ],
        "filenamePatterns": [
          "**/cron.d/*",
          "**/crontabs/*"
        ],
        "configuration": "./language-configurations/line-based.json"
      }
    ],
    "grammars": [
      {
        "language": "confetti-nginx",
        "scopeName": "source.confetti.nginx",
        "path": "./syntaxes/nginx.tmLanguage.json"
      },
      {
        "language": "confetti-ssh",
        "scopeName": "source.confetti.ssh",
        "path": "./syntaxes/ssh.tmLanguage.json"
      },
      {
        "language": "confetti-env",
        "scopeName": "source.confetti.env",
        "path": "./syntaxes/env.tmLanguage.json"
      },
      {
        "language": "confetti-ini",
        "scopeName": "source.confetti.ini",
        "path": "./syntaxes/ini.tmLanguage.json"
      },
      {
        "language": "confetti-properties",
        "scopeName": "source.confetti.properties",
        "path": "./syntaxes/properties.tmLanguage.json"
      },
      {
        "language": "confetti-toml",
        "scopeName": "source.confetti.toml",
        "path": "./syntaxes/toml.tmLanguage.json"
      },
      {
        "language": "confetti-gitconfig",
        "scopeName": "source.confetti.gitconfig",
        "path": "./syntaxes/gitconfig.tmLanguage.json"
      },
      {
        "language": "confetti-npmrc",
        "scopeName": "source.confetti.npmrc",
        "path": "./syntaxes/npmrc.tmLanguage.json"
      },
      {
        "language": "confetti-yarnrc",
        "scopeName": "source.confetti.yarnrc",
        "path": "./syntaxes/yarnrc.tmLanguage.json"
      },
      {
        "language": "confetti-yaml",
        "scopeName": "source.confetti.yaml",
        "path": "./syntaxes/yaml.tmLanguage.json"
      },
      {
        "language": "confetti-ignore",
        "scopeName": "source.confetti.ignore",
        "path": "./syntaxes/ignore.tmLanguage.json"
      },
      {
        "language": "confetti-gitattributes",
        "scopeName": "source.confetti.gitattributes",
        "path": "./syntaxes/gitattributes.tmLanguage.json"
      },
      {
        "language": "confetti-browserslist",
        "scopeName": "source.confetti.browserslist",
        "path": "./syntaxes/browserslist.tmLanguage.json"
      },
      {
        "language": "confetti-versions",
        "scopeName": "source.confetti.versions",
        "path": "./syntaxes/versions.tmLanguage.json"
      },
      {
        "language": "confetti-hosts",
        "scopeName": "source.confetti.hosts",
        "path": "./syntaxes/hosts.tmLanguage.json"
      },
      {
        "language": "confetti-fstab",
        "scopeName": "source.confetti.fstab",
        "path": "./syntaxes/fstab.tmLanguage.json"
      },
      {
        "language": "confetti-crontab",
        "scopeName": "source.confetti.crontab",
        "path": "./syntaxes/crontab.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/vscode": "1.90.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
